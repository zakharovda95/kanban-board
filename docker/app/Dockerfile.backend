FROM node:22-alpine AS build
WORKDIR /app

COPY package.json ./
COPY packages/common/package.json ./packages/common/
COPY packages/backend/package.json ./packages/backend/

RUN npm install --ignore-scripts \
  --workspace=@kanban-board/common \
  --workspace=@kanban-board/backend

COPY packages/common ./packages/common
COPY packages/backend ./packages/backend

RUN npm run build -w @kanban-board/common \
  && npm run build -w @kanban-board/backend \
  && npm prune --omit=dev \
  && rm -rf \
    packages/common/src \
    packages/backend/src \
    packages/common/node_modules \
    packages/backend/node_modules \
    packages/common/tsconfig*.json \
    packages/backend/tsconfig*.json \
    packages/common/vite.config.* \
    packages/backend/nest-cli.json \
    packages/common/eslint.config.* \
    packages/backend/eslint.config.* \
    packages/common/*.md \
    packages/backend/*.md

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/common/package.json ./packages/common/
COPY --from=build /app/packages/common/dist ./packages/common/dist
COPY --from=build /app/packages/backend/package.json ./packages/backend/
COPY --from=build /app/packages/backend/dist ./packages/backend/dist

WORKDIR /app/packages/backend
EXPOSE 3000
CMD ["node", "dist/main.js"]
