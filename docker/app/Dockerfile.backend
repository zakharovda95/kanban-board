FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json ./
COPY packages/common/package.json ./packages/common/
COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/

RUN npm install --ignore-scripts --workspace=@kanban-board/common --workspace=@kanban-board/backend

FROM deps AS build
COPY packages/common ./packages/common
COPY packages/backend ./packages/backend

RUN npm run build -w @kanban-board/common \
  && npm run build -w @kanban-board/backend

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY package.json ./
COPY packages/common/package.json ./packages/common/
COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/

RUN npm install --omit=dev --ignore-scripts --workspace=@kanban-board/common --workspace=@kanban-board/backend

COPY --from=build /app/packages/common/dist ./packages/common/dist
COPY --from=build /app/packages/backend/dist ./packages/backend/dist

WORKDIR /app/packages/backend
EXPOSE 3001
CMD ["node", "dist/main.js"]
