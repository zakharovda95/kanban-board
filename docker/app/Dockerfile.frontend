FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json ./
COPY packages/common/package.json ./packages/common/
COPY packages/frontend/package.json ./packages/frontend/

RUN npm install --ignore-scripts \
  --workspace=@kanban-board/common \
  --workspace=@kanban-board/frontend

FROM deps AS build
COPY packages/common ./packages/common
COPY packages/frontend ./packages/frontend

ARG NODE_ENV=production
ARG BACKEND_URL
ARG FRONTEND_URL
ARG WEBSOCKET_URL
ARG MINIO_ENDPOINT
ARG MINIO_PORT
ARG MINIO_USE_SSL
ARG MINIO_BUCKET
ARG MINIO_PUBLIC_URL

ENV NODE_ENV=$NODE_ENV \
    BACKEND_URL=$BACKEND_URL \
    FRONTEND_URL=$FRONTEND_URL \
    WEBSOCKET_URL=$WEBSOCKET_URL \
    MINIO_ENDPOINT=$MINIO_ENDPOINT \
    MINIO_PORT=$MINIO_PORT \
    MINIO_USE_SSL=$MINIO_USE_SSL \
    MINIO_BUCKET=$MINIO_BUCKET \
    MINIO_PUBLIC_URL=$MINIO_PUBLIC_URL

RUN npm run build -w @kanban-board/common \
  && cd packages/frontend \
  && npx nuxt build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    NITRO_HOST=0.0.0.0

COPY --from=build /app/packages/frontend/.output ./.output
COPY --from=build /app/packages/frontend/package.json ./package.json

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
